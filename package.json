{
  "name": "profile-v1",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev:web": "pnpm --filter @profile/web dev",
    "dev:calendar": "pnpm --filter @profile/calendar dev",
    "dev:calendar-mobile": "node deploy/scripts/native/require-native-package.mjs @profile/calendar-mobile && pnpm --filter @profile/calendar-mobile dev",
    "build:calendar": "pnpm --filter @profile/calendar build",
    "build:calendar-mobile": "node deploy/scripts/native/require-native-package.mjs @profile/calendar-mobile && pnpm --filter @profile/calendar-mobile build",
    "build:calendar-mobile:android": "node deploy/scripts/native/require-native-package.mjs @profile/calendar-mobile && bash app_mobile/calendar-mobile/scripts/android-release-build.sh",
    "dev:teach-hub": "pnpm --filter @profile/teach-hub dev",
    "dev:showmasterpiece": "pnpm --filter @profile/showmasterpiece dev",
    "build:showmasterpiece": "pnpm --filter @profile/showmasterpiece build",
    "dev:node-notes": "pnpm --filter @profile/node-notes dev",
    "build:node-notes": "pnpm --filter @profile/node-notes build",
    "build:money-research": "pnpm --filter @profile/money-research build",
    "dev:teach-hub-desktop": "node deploy/scripts/native/require-native-package.mjs @profile/teach-hub-desktop && pnpm --filter @profile/teach-hub-desktop dev",
    "dev:lan-drop": "node deploy/scripts/native/require-native-package.mjs @profile/lan-drop && pnpm --filter @profile/lan-drop dev",
    "build:teach-hub": "pnpm --filter @profile/teach-hub build",
    "build:teach-hub-mobile": "node deploy/scripts/native/require-native-package.mjs @profile/teach-hub-mobile && pnpm --filter @profile/teach-hub-mobile build",
    "build:teach-hub-mobile:android": "node deploy/scripts/native/require-native-package.mjs @profile/teach-hub-mobile && bash app_mobile/teach-hub-mobile/scripts/android-release-build.sh",
    "package:teach-hub": "bash deploy/scripts/docker/teach-hub-docker-package.sh",
    "package:calendar": "bash deploy/scripts/docker/calendar-docker-package.sh",
    "package:showmasterpiece": "bash deploy/scripts/docker/showmasterpiece-docker-package.sh",
    "package:money-research": "bash deploy/scripts/docker/money-research-docker-package.sh",
    "package:node-notes": "bash deploy/scripts/docker/node-notes-docker-package.sh",
    "build:web": "pnpm --filter @profile/web build",
    "build:all": "turbo run build --filter=@profile/web --filter=@profile/calendar --filter=@profile/teach-hub --filter=@profile/showmasterpiece --filter=@profile/money-research --filter=@profile/node-notes --filter=@profile/idea-list --filter=@profile/filetransfer --filter=@profile/ticket-monitor --filter=@profile/fitness-plan --filter=@profile/comfy-prompt --filter=@profile/utilities",
    "dev": "pnpm --filter @profile/web dev",
    "dev:sync-sa2kit": "pnpm build:libs && pnpm --filter @profile/web dev",
    "dev:3002": "pnpm --filter @profile/web dev:3002",
    "dev:3003": "pnpm --filter @profile/web dev:3003",
    "dev:https": "pnpm --filter @profile/web dev:https",
    "build:libs": "node deploy/scripts/gate/ensure-sa2kit-workspace-dist.mjs",
    "build:libs:force": "rm -rf packages/sa2kit/dist packages/sa2kit-ui/packages/shared/dist packages/sa2kit-ui/packages/react/dist && pnpm build:libs",
    "postinstall": "node deploy/scripts/gate/check-required-submodules.mjs && node deploy/scripts/gate/ensure-sa2kit-workspace-dist.mjs",
    "native:enable": "node deploy/scripts/native/enable-native-workspace.mjs",
    "native:disable": "node deploy/scripts/native/disable-native-workspace.mjs",
    "build": "pnpm --filter @profile/web build",
    "start": "pnpm --filter @profile/web start",
    "lint": "pnpm --filter @profile/web lint",
    "gate:ui": "node deploy/scripts/gate/check-ui-unification-gate.mjs",
    "gate:architecture": "node deploy/scripts/gate/check-architecture-gate.mjs",
    "test": "tsx deploy/scripts/gate/verify-public-http-url.ts && tsx deploy/scripts/gate/verify-auth-base-url.ts && tsx deploy/scripts/gate/verify-examples-block.ts && tsx deploy/scripts/gate/verify-public-api-allowlist.ts && tsx deploy/scripts/gate/verify-is-admin-role.ts && tsx deploy/scripts/gate/verify-write-api-session-gate.ts && tsx deploy/scripts/gate/verify-db-no-auth-dep.ts",
    "test:turbo": "turbo run test --filter=profile-v1",
    "gate": "pnpm gate:ui && pnpm gate:architecture && pnpm test",
    "config:doctor": "tsx --import @profile/config/preload deploy/scripts/config/config-doctor.ts",
    "config:verify-business": "tsx --import @profile/config/preload deploy/scripts/gate/verify-business-config.ts",
    "config:sops-init": "bash deploy/scripts/config/config-sops-init.sh",
    "config:encrypt-production": "bash deploy/scripts/config/config-encrypt-production.sh",
    "config:decrypt-production": "bash deploy/scripts/config/config-decrypt-production.sh",
    "config:install-sops": "bash deploy/scripts/config/install-sops.sh",
    "devdb:generate": "tsx --import @profile/config/preload node_modules/drizzle-kit/bin.cjs generate",
    "devdb:push": "tsx --import @profile/config/preload deploy/scripts/db/ensure-auth-enum.ts && tsx --import @profile/config/preload deploy/scripts/db/ensure-account-issuer.ts && tsx --import @profile/config/preload deploy/scripts/db/drizzle-push.ts",
    "devdb:migrate": "tsx --import @profile/config/preload host/db/src/migrate.ts",
    "devdb:studio": "tsx --import @profile/config/preload node_modules/drizzle-kit/bin.cjs studio --port 3500",
    "prodb:generate": "APP_CONFIG_ENV=production tsx --import @profile/config/preload node_modules/drizzle-kit/bin.cjs generate",
    "prodb:push": "echo 'prodb:push 已停用，请改用 pnpm prodb:migrate（紧急: ALLOW_DRIZZLE_PUSH=1 APP_CONFIG_ENV=production tsx --import @profile/config/preload deploy/scripts/db/drizzle-push.ts）' && exit 1",
    "prodb:migrate": "APP_CONFIG_ENV=production tsx --import @profile/config/preload host/db/src/migrate.ts",
    "prodb:studio": "APP_CONFIG_ENV=production tsx --import @profile/config/preload node_modules/drizzle-kit/bin.cjs studio --port 3500",
    "devdb:createusers": "tsx --import @profile/config/preload deploy/scripts/db/create-test-user-accounts.ts",
    "prodb:createusers": "APP_CONFIG_ENV=production tsx --import @profile/config/preload deploy/scripts/db/create-test-user-accounts.ts",
    "devdb:migrate:festivalcard": "tsx --import @profile/config/preload deploy/scripts/db/migrate-festival-card.ts",
    "prodb:migrate:festivalcard": "APP_CONFIG_ENV=production tsx --import @profile/config/preload deploy/scripts/db/migrate-festival-card.ts",
    "test:skill-manager:validation": "tsx deploy/scripts/tools/skill-manager-validation-test.ts",
    "ticket-monitor:sync": "tsx --import @profile/config/preload app_web/ticket-monitor/scripts/run-sync.ts",
    "ai:test-mimo": "tsx --import @profile/config/preload deploy/scripts/tools/test-ai-mimo.ts",
    "ci:feishu-notify": "node deploy/scripts/ci/send-ci-feishu-notify.mjs",
    "dev:idea-list": "pnpm --filter @profile/idea-list dev",
    "build:idea-list": "pnpm --filter @profile/idea-list build",
    "package:idea-list": "bash deploy/scripts/docker/idea-list-docker-package.sh",
    "dev:filetransfer": "pnpm --filter @profile/filetransfer dev",
    "build:filetransfer": "pnpm --filter @profile/filetransfer build",
    "package:filetransfer": "bash deploy/scripts/docker/filetransfer-docker-package.sh",
    "dev:ticket-monitor": "pnpm --filter @profile/ticket-monitor dev",
    "build:ticket-monitor": "pnpm --filter @profile/ticket-monitor build",
    "package:ticket-monitor": "bash deploy/scripts/docker/ticket-monitor-docker-package.sh",
    "dev:fitness-plan": "pnpm --filter @profile/fitness-plan dev",
    "build:fitness-plan": "pnpm --filter @profile/fitness-plan build",
    "package:fitness-plan": "bash deploy/scripts/docker/fitness-plan-docker-package.sh",
    "dev:comfy-prompt": "pnpm --filter @profile/comfy-prompt dev",
    "build:comfy-prompt": "pnpm --filter @profile/comfy-prompt build",
    "package:comfy-prompt": "bash deploy/scripts/docker/comfy-prompt-docker-package.sh",
    "dev:utilities": "pnpm --filter @profile/utilities dev",
    "build:utilities": "pnpm --filter @profile/utilities build",
    "package:utilities": "bash deploy/scripts/docker/utilities-docker-package.sh"
  },
  "dependencies": {
    "@profile/auth": "workspace:*",
    "@profile/config": "workspace:*",
    "@profile/db": "workspace:*",
    "drizzle-orm": "^0.44.7",
    "postgres": "^3.4.5",
    "sa2kit": "workspace:*",
    "nanoid": "^5.1.5",
    "yaml": "^2.8.0"
  },
  "devDependencies": {
    "@types/node": "^20.17.12",
    "dotenv": "^16.4.7",
    "drizzle-kit": "^0.31.1",
    "tsx": "^4.19.4",
    "turbo": "^2.5.4",
    "typescript": "^5.7.3"
  },
  "packageManager": "pnpm@9.15.0+sha512.76e2379760a4328ec4415815bcd6628dee727af3779aaa4c914e3944156c4299921a89f976381ee107d41f12cfa4b66681ca9c718f0668fa0831ed4c6d8ba56c",
  "pnpm": {
    "overrides": {
      "@sa2kit-ui/react": "workspace:*",
      "@types/react": "19.1.17",
      "@types/react-dom": "19.2.5",
      "@types/three": "0.177.0",
      "browserslist": "4.28.2",
      "drizzle-orm": "0.44.7",
      "three": "0.177.0",
      "three-bmfont-text": "https://codeload.github.com/dmarcos/three-bmfont-text/tar.gz/c3eec235b9188aa0d8ed949101236e6d5fccf071"
    },
    "peerDependencyRules": {
      "ignoreMissing": [
        "@sa2kit-ui/rn"
      ]
    }
  }
}

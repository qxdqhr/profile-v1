# 复制为 deploy/.env 后 docker compose -f docker-compose.gateway.yml up -d

REGISTRY=crpi-pnnot5dqi45utyya.cn-beijing.personal.cr.aliyuncs.com/qhrqht
IMAGE_TAG=123
GATEWAY_PORT=3000

# 可选：容器内连宿主机 Postgres（与 app.config.yaml 中 database.url 二选一，优先此项）
# DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@host.docker.internal:5432/exam_system

# --- WordPress 旁路（/wp/holt/；与 Postgres 无关）---
# 首次上线请改强密码；deploy-profile-v1.sh 重写 .env 时会保留下列键
MARIADB_ROOT_PASSWORD=change-me-root
WORDPRESS_DB_USER=wp
WORDPRESS_DB_PASSWORD=change-me-wp
WORDPRESS_DB_NAME=wp_holt
WP_HOLT_PUBLIC_URL=https://qhr062.top/wp/holt

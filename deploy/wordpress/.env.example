# 复制为 deploy/.env（与网关共用）或本目录 .env（仅 docker-compose.dev.yml）

# MariaDB
MARIADB_ROOT_PASSWORD=change-me-root
WORDPRESS_DB_USER=wp
WORDPRESS_DB_PASSWORD=change-me-wp
WORDPRESS_DB_NAME=wp_holt

# 公网前缀（须与 nginx location 一致；生产用 https）
# 网关反代后浏览器看到的地址，例如 https://qhr062.top/wp/holt
WP_HOLT_PUBLIC_URL=http://127.0.0.1:18080/wp/holt

# 本地 compose.dev 映射端口（避免与本机已占用的 8080 冲突）
WP_DEV_HTTP_PORT=18080
MARIADB_DEV_PORT=3307
